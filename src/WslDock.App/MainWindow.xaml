<Window x:Class="WslDock.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WslDock" Height="650" Width="1000" MinHeight="480" MinWidth="760" WindowStartupLocation="CenterScreen" Background="#F4F6F8">
  <Window.Resources><Style TargetType="Button"><Setter Property="Padding" Value="16,7"/><Setter Property="Margin" Value="0,0,8,0"/></Style></Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="160"/></Grid.RowDefinitions>
    <Border Background="White" Padding="16" CornerRadius="6"><Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="280"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="WSL Distribution" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/><ComboBox Grid.Column="1" ItemsSource="{Binding Distributions}" SelectedItem="{Binding SelectedDistribution}" DisplayMemberPath="Name" Padding="7"/>
      <TextBlock Grid.Column="3" Text="Docker Engine" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/><TextBlock Grid.Column="4" Text="{Binding EngineStatus}" VerticalAlignment="Center" FontSize="15"/><Button Grid.Column="5" Content="Refresh" Command="{Binding RefreshCommand}" Margin="12,0,0,0"/>
    </Grid></Border>
    <Border Grid.Row="1" Background="#FFF0F0" BorderBrush="#E0A0A0" BorderThickness="1" Padding="10" Margin="0,12,0,0"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding ErrorMessage}" Foreground="#9A2020" TextWrapping="Wrap"/></Border>
    <DataGrid Grid.Row="2" Margin="0,12" ItemsSource="{Binding Containers}" SelectedItem="{Binding SelectedContainer}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" GridLinesVisibility="Horizontal"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.3*"/><DataGridTextColumn Header="Image" Binding="{Binding Image}" Width="1.5*"/><DataGridTextColumn Header="State" Binding="{Binding State}" Width="*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1.5*"/><DataGridTextColumn Header="Ports" Binding="{Binding Ports}" Width="1.5*"/></DataGrid.Columns></DataGrid>
    <Grid Grid.Row="3"><StackPanel Orientation="Horizontal"><Button Content="Start" Command="{Binding StartCommand}"/><Button Content="Stop" Command="{Binding StopCommand}"/><Button Content="Restart" Command="{Binding RestartCommand}"/><Button Content="Logs" Command="{Binding LoadLogsCommand}"/></StackPanel><TextBlock Text="Working…" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
    <GroupBox Grid.Row="4" Header="Container logs" Margin="0,12,0,0"><TextBox Text="{Binding Logs, Mode=OneWay}" FontFamily="Consolas" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" Padding="8"/></GroupBox>
  </Grid>
</Window>
