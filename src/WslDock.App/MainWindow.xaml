<Window x:Class="WslDock.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:WslDock.App.Views" Title="WslDock" Height="720" Width="1100" MinHeight="520" MinWidth="800" WindowStartupLocation="CenterScreen" Background="#F4F6F8">
  <Window.Resources><Style TargetType="Button"><Setter Property="Padding" Value="14,6"/><Setter Property="Margin" Value="0,0,8,0"/></Style></Window.Resources>
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <Border Background="White" Padding="14" CornerRadius="6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="280"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="WSL Distribution" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/><ComboBox Grid.Column="1" ItemsSource="{Binding Distributions}" SelectedItem="{Binding SelectedDistribution}" DisplayMemberPath="Name" Padding="7"/><TextBlock Grid.Column="3" Text="Docker Engine" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/><TextBlock Grid.Column="4" Text="{Binding EngineStatus}" VerticalAlignment="Center" FontSize="15"/><Button Grid.Column="5" Content="Refresh containers" Command="{Binding RefreshCommand}"/></Grid></Border>
    <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,8"/>
    <TabControl Grid.Row="2">
      <TabItem Header="Containers"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="140"/></Grid.RowDefinitions><DataGrid ItemsSource="{Binding Containers}" SelectedItem="{Binding SelectedContainer}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Image" Binding="{Binding Image}" Width="*"/><DataGridTextColumn Header="State" Binding="{Binding State}"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/><DataGridTextColumn Header="Ports" Binding="{Binding Ports}" Width="*"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8"><Button Content="Start" Command="{Binding StartCommand}"/><Button Content="Stop" Command="{Binding StopCommand}"/><Button Content="Restart" Command="{Binding RestartCommand}"/><Button Content="Remove" Command="{Binding RemoveCommand}"/><Button Content="Logs" Command="{Binding LoadLogsCommand}"/></StackPanel><TextBox Grid.Row="2" Text="{Binding Logs}" FontFamily="Consolas" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/></Grid></TabItem>
      <TabItem Header="Images"><views:ImagesView DataContext="{Binding ImagesViewModel}"/></TabItem>
      <TabItem Header="Volumes"><views:VolumesView DataContext="{Binding VolumesViewModel}"/></TabItem>
      <TabItem Header="Networks"><views:NetworksView DataContext="{Binding NetworksViewModel}"/></TabItem>
      <TabItem Header="Compose"><views:ComposeProjectsView DataContext="{Binding ComposeViewModel}"/></TabItem>
    </TabControl>
  </Grid>
</Window>
