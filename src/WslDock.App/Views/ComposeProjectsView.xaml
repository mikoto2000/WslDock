<UserControl x:Class="WslDock.App.Views.ComposeProjectsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="130"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Project" Binding="{Binding Name}"/><DataGridTextColumn Header="Status" Binding="{Binding Status}"/><DataGridTextColumn Header="Config files" Binding="{Binding ConfigFiles[0]}" Width="*"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8"><Button Content="Up" Command="{Binding UpCommand}"/><Button Content="Down" Command="{Binding DownCommand}"/><Button Content="Restart" Command="{Binding RestartCommand}"/><Button Content="Logs" Command="{Binding LogsCommand}"/><Button Content="Refresh" Command="{Binding RefreshCommand}"/></StackPanel><DataGrid Grid.Row="2" ItemsSource="{Binding Services}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Service" Binding="{Binding Service}"/><DataGridTextColumn Header="Container" Binding="{Binding ContainerName}"/><DataGridTextColumn Header="Image" Binding="{Binding Image}" Width="*"/><DataGridTextColumn Header="State" Binding="{Binding State}"/><DataGridTextColumn Header="Status" Binding="{Binding Status}"/><DataGridTextColumn Header="Ports" Binding="{Binding Ports}"/></DataGrid.Columns></DataGrid><TextBox Grid.Row="3" Text="{Binding Logs}" FontFamily="Consolas" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/><TextBlock Grid.Row="4" Text="{Binding ErrorMessage}" Foreground="Firebrick" TextWrapping="Wrap"/></Grid></UserControl>
