<UserControl x:Class="WslDock.App.Views.ImagesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid ItemsSource="{Binding Images}" SelectedItem="{Binding SelectedImage}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Repository" Binding="{Binding Repository}" Width="*"/><DataGridTextColumn Header="Tag" Binding="{Binding Tag}"/><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="*"/><DataGridTextColumn Header="Created" Binding="{Binding Created}"/><DataGridTextColumn Header="Size" Binding="{Binding Size}"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10"><TextBox Text="{Binding ImageReference, UpdateSourceTrigger=PropertyChanged}" Width="360"/><Button Content="Pull" Command="{Binding PullCommand}"/></StackPanel><StackPanel Grid.Row="2" Orientation="Horizontal"><Button Content="Remove" Command="{Binding RemoveCommand}"/><Button Content="Prune unused images" Command="{Binding PruneCommand}"/><Button Content="Refresh" Command="{Binding RefreshCommand}"/></StackPanel><TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" Foreground="Firebrick" TextWrapping="Wrap"/></Grid></UserControl>
