<UserControl x:Class="WslDock.App.Views.NetworksView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid ItemsSource="{Binding Networks}" SelectedItem="{Binding SelectedNetwork}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="*"/><DataGridTextColumn Header="Driver" Binding="{Binding Driver}"/><DataGridTextColumn Header="Scope" Binding="{Binding Scope}"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10"><Button Content="Remove" Command="{Binding RemoveCommand}"/><Button Content="Prune unused networks" Command="{Binding PruneCommand}"/><Button Content="Refresh" Command="{Binding RefreshCommand}"/></StackPanel><TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="Firebrick"/></Grid></UserControl>
